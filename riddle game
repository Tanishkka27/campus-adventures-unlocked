<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Riddle Rush — Enhanced (Vanilla JS)</title>
<style>
  :root{
    --bg:#071025; --card:#081226; --muted:#9aa4b2; --accent:#7c3aed; --accent-2:#06b6d4; --success:#16a34a; --danger:#ef4444;
    --glass: rgba(255,255,255,0.03);
    color-scheme: dark;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
  }
  *{box-sizing:border-box}
  html,body{height:100%}
  body{
    margin:0; min-height:100vh; background:
      radial-gradient(1200px 600px at 10% 10%, rgba(124,58,237,0.06), transparent 6%),
      radial-gradient(900px 400px at 90% 80%, rgba(6,182,212,0.04), transparent 6%),
      linear-gradient(180deg,#031025 0%, var(--bg) 100%);
    display:flex; align-items:start; justify-content:center; padding:28px;
    color:#e9f0fb;
  }
  .wrap{width:100%; max-width:1150px; display:grid; grid-template-columns:320px 1fr; gap:20px}
  .card{background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01)); border-radius:14px; padding:16px; box-shadow:0 10px 40px rgba(2,6,23,0.7); border:1px solid rgba(255,255,255,0.03)}
  h2{margin:0 0 6px 0; font-size:18px}
  small{color:var(--muted)}
  /* left */
  .player-list{margin-top:12px; display:flex; flex-direction:column; gap:10px; max-height:60vh; overflow:auto; padding-right:6px}
  .player{display:flex; align-items:center; justify-content:space-between; gap:8px; background:var(--glass); padding:8px; border-radius:10px; transition:transform .18s ease, box-shadow .18s ease}
  .player:hover{transform:translateY(-4px); box-shadow:0 6px 22px rgba(2,6,23,0.5)}
  .left{display:flex; gap:10px; align-items:center}
  .avatar{width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,#0f1724,#111522); display:flex;align-items:center;justify-content:center;font-weight:800;color:#fff}
  .btn{background:linear-gradient(90deg,var(--accent),var(--accent-2)); border:none; color:white; padding:8px 10px; border-radius:10px; cursor:pointer; font-weight:700}
  .btn.ghost{background:transparent;border:1px solid rgba(255,255,255,0.06); color:var(--muted); font-weight:600}
  .btn.warn{background:linear-gradient(90deg,#ef4444,#f97316)}
  .controls{display:flex; gap:8px; margin-top:12px}
  input[type="text"], input[type="number"]{width:100%; padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,0.04); background:transparent; color:inherit}
  .small{font-size:13px;color:var(--muted)}
  /* main */
  .main-grid{display:grid; grid-template-rows:auto 1fr auto; gap:14px}
  .riddle-card{padding:18px; border-radius:12px; min-height:180px; display:flex; flex-direction:column; justify-content:space-between; background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01)); border:1px solid rgba(255,255,255,0.025)}
  .question{font-size:20px; font-weight:700; line-height:1.18}
  .points{font-size:13px; color:var(--muted)}
  .actions{display:flex; gap:8px; margin-top:10px; align-items:center}
  .answer{padding:10px;border-radius:10px;background:transparent;border:1px solid rgba(255,255,255,0.04); color:inherit; width:100%}
  .hint{background:linear-gradient(90deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01)); padding:10px;border-radius:10px;border:1px dashed rgba(255,255,255,0.03); color:var(--muted); margin-top:10px}
  /* leaderboard */
  .leader{display:flex; flex-direction:column; gap:10px}
  .leader-item{display:flex; justify-content:space-between; align-items:center; padding:10px; border-radius:10px; background:linear-gradient(90deg, rgba(255,255,255,0.01), rgba(255,255,255,0.008)); border:1px solid rgba(255,255,255,0.02); transition:transform .35s cubic-bezier(.2,.9,.3,1), opacity .25s; will-change:transform}
  .leader-item.new{animation:pop .45s ease}
  @keyframes pop{0%{transform:scale(.92);opacity:0}60%{transform:scale(1.05);opacity:1}100%{transform:scale(1);opacity:1}}
  .badge{background:linear-gradient(90deg,#f59e0b,#ef4444); padding:6px 8px; border-radius:999px; color:#061826; font-weight:800}
  .top-row{display:flex; justify-content:space-between; align-items:center}
  footer{display:flex; justify-content:space-between; align-items:center; gap:8px}
  .msg{padding:10px;border-radius:10px;background:rgba(255,255,255,0.02); color:var(--muted)}
  .muted{color:var(--muted)}
  /* small screens */
  @media (max-width:980px){ .wrap{grid-template-columns:1fr; padding-bottom:70px} .card{padding:12px} .avatar{width:38px;height:38px} }
  /* subtle highlight when score updates */
  .glow{box-shadow:0 6px 30px rgba(124,58,237,0.16); transform:translateY(-6px)}
  /* share badge */
  .sharebar{display:flex; gap:8px; align-items:center}
  /* confetti */
  .confetti-canvas{position:fixed; left:0; top:0; pointer-events:none; z-index:999}
</style>
</head>
<body>
<div class="wrap">
  <!-- Left column -->
  <aside class="card">
    <div class="top-row">
      <div>
        <h2>Players</h2>
        <small>Manage players • select one to play</small>
      </div>
      <div class="small" id="roundsPlayed">Rounds: 0</div>
    </div>

    <div style="margin-top:12px; display:flex; gap:8px;">
      <input id="playerName" type="text" placeholder="Add player name..." />
      <button id="addPlayerBtn" class="btn">Add</button>
    </div>

    <div class="player-list" id="playerList"></div>

    <div class="controls" style="margin-top:12px">
      <button id="exportCSV" class="btn ghost">Export CSV</button>
      <button id="copyState" class="btn ghost">Copy state</button>
      <button id="shareLink" class="btn ghost">Share link</button>
      <button id="resetBtn" class="btn ghost warn">Reset</button>
    </div>

    <div style="margin-top:12px" class="small">Hint costs <strong>3 points</strong>. Correct answer awards listed points. Use Share link to create a URL others can open to load the same game state.</div>
  </aside>

  <!-- Right column -->
  <main class="card main-grid">
    <div class="top-row">
      <div>
        <h2>Riddle Rush</h2>
        <small>Solve riddles, climb the leaderboard 🎯</small>
      </div>
      <div>
        <div class="small">Current: <strong id="currentPlayer">—</strong></div>
      </div>
    </div>

    <section>
      <div class="riddle-card" id="riddleCard">
        <div>
          <div class="points small" id="rPoints">Points: —</div>
          <div class="question" id="rQuestion">Press "Start Turn" or load a random riddle.</div>
        </div>

        <div>
          <form id="answerForm" style="display:flex; gap:8px; align-items:center;">
            <input id="answerInput" class="answer" placeholder="Type answer..." autocomplete="off"/>
            <button id="submitAnswer" class="btn" type="submit">Submit</button>
            <button id="hintBtn" class="btn ghost" type="button">Hint (-3)</button>
            <button id="skipBtn" class="btn ghost" type="button">Skip</button>
          </form>
          <div id="hintBox" class="hint" style="display:none"></div>
        </div>
      </div>

      <div style="display:flex; gap:12px; margin-top:12px; align-items:center;">
        <button id="startTurn" class="btn">Start Turn</button>
        <button id="randomRiddle" class="btn ghost">Random Riddle</button>
        <div id="msg" class="msg" style="flex:1">Ready — add players and press Start Turn.</div>
      </div>
    </section>

    <footer>
      <div style="width:65%">
        <h3 style="margin:0">Leaderboard</h3>
        <div id="leaderboard" class="leader" style="margin-top:10px; max-height:240px; overflow:auto"></div>
      </div>

      <div style="width:33%">
        <h3 style="margin:0">Add Riddle</h3>
        <form id="addRiddleForm" style="display:flex; flex-direction:column; gap:8px; margin-top:8px">
          <input id="rQ" type="text" placeholder="Riddle question" required />
          <input id="rA" type="text" placeholder="Answer (single phrase preferred)" required />
          <input id="rP" type="number" placeholder="Points (default 5)" min="1" value="5" />
          <input id="rHint" type="text" placeholder="Hint (optional)" />
          <div style="display:flex; gap:8px">
            <button class="btn" type="submit">Save</button>
            <button id="clearRiddle" class="btn ghost" type="button">Clear</button>
          </div>
        </form>
      </div>
    </footer>
  </main>
</div>

<canvas id="confetti" class="confetti-canvas"></canvas>

<script>
/* ========== Enhanced Riddle Rush (vanilla JS) ========== */

/* ======= State and defaults ======= */
const LS_KEY = 'riddle_rush_enh_v1';

let state = {
  players: [],   // {id,name,score,played}
  riddles: [],   // {id,q,a,hint,points}
  roundsPlayed: 0
};

// default riddles
const defaultRiddles = [
  {id:1,q:"I speak without a mouth and hear without ears. I come alive with wind. What am I?", a:"echo", hint:"You hear it in a canyon.", points:10},
  {id:2,q:"I’m light as a feather, yet the strongest man can’t hold me for much longer than a minute. What am I?", a:"breath", hint:"You do it every few seconds.", points:8},
  {id:3,q:"What can travel around the world while staying in a corner?", a:"stamp", hint:"You stick it on an envelope.", points:6},
  {id:4,q:"The more of this there is, the less you see. What is it?", a:"darkness", hint:"It falls at night.", points:7},
  {id:5,q:"What has keys but can’t open locks?", a:"piano", hint:"It makes music.", points:5}
];

/* ======= Elements ======= */
const els = {
  playerList:document.getElementById('playerList'),
  playerName:document.getElementById('playerName'),
  addPlayerBtn:document.getElementById('addPlayerBtn'),
  currentPlayerName:document.getElementById('currentPlayer'),
  startTurn:document.getElementById('startTurn'),
  randomRiddle:document.getElementById('randomRiddle'),
  rQuestion:document.getElementById('rQuestion'),
  rPoints:document.getElementById('rPoints'),
  answerForm:document.getElementById('answerForm'),
  answerInput:document.getElementById('answerInput'),
  hintBtn:document.getElementById('hintBtn'),
  hintBox:document.getElementById('hintBox'),
  skipBtn:document.getElementById('skipBtn'),
  msg:document.getElementById('msg'),
  leaderboard:document.getElementById('leaderboard'),
  exportCSV:document.getElementById('exportCSV'),
  resetBtn:document.getElementById('resetBtn'),
  addRiddleForm:document.getElementById('addRiddleForm'),
  rQ:document.getElementById('rQ'),
  rA:document.getElementById('rA'),
  rP:document.getElementById('rP'),
  rHint:document.getElementById('rHint'),
  clearRiddle:document.getElementById('clearRiddle'),
  roundsPlayed:document.getElementById('roundsPlayed'),
  copyState:document.getElementById('copyState'),
  shareLink:document.getElementById('shareLink')
};

let currentPlayerId = null;
let currentRiddle = null;

/* ======= Persistence ======= */
function loadStateFromURL(){ // shareable URL uses location.hash (base64 JSON)
  try{
    if(location.hash && location.hash.length>1){
      const encoded = decodeURIComponent(location.hash.slice(1));
      if(encoded.startsWith('state:')){
        const b = encoded.slice(6);
        const json = atob(b);
        const obj = JSON.parse(json);
        if(obj && obj.riddles && obj.players) return obj;
      }
    }
  }catch(e){ console.warn('Failed to load state from URL', e) }
  return null;
}
function loadState(){
  const fromURL = loadStateFromURL();
  if(fromURL) { state = fromURL; saveState(); return; }
  try{
    const raw = localStorage.getItem(LS_KEY);
    if(raw) state = JSON.parse(raw);
    if(!state.riddles || !state.riddles.length) state.riddles = defaultRiddles.slice();
  }catch(e){
    state = {players:[], riddles: defaultRiddles.slice(), roundsPlayed:0};
  }
}
function saveState(){ localStorage.setItem(LS_KEY, JSON.stringify(state)); }

/* ======= Utils ======= */
function uid(){ return Date.now().toString(36) + Math.random().toString(36).slice(2,6) }
function pickRiddle(){ if(!state.riddles.length) return null; return state.riddles[Math.floor(Math.random()*state.riddles.length)]; }
function escapeHTML(s){ return String(s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

/* ======= Rendering ======= */
function renderPlayers(){
  els.playerList.innerHTML = '';
  if(state.players.length===0){
    els.playerList.innerHTML = '<div class="small">No players yet. Add players to begin.</div>';
    els.currentPlayerName.textContent = '—';
    return;
  }
  state.players.forEach(p=>{
    const node = document.createElement('div'); node.className='player';
    node.innerHTML = `
      <div class="left">
        <div class="avatar">${escapeHTML(p.name.slice(0,2)).toUpperCase()}</div>
        <div>
          <div style="font-weight:700">${escapeHTML(p.name)}</div>
          <div class="small">Score: ${p.score} • Played: ${p.played}</div>
        </div>
      </div>
      <div style="display:flex; gap:6px; align-items:center">
        <button class="btn ghost pickBtn" data-id="${p.id}">Pick</button>
        <button class="btn ghost warn removeBtn" data-id="${p.id}">Remove</button>
      </div>`;
    els.playerList.appendChild(node);
  });
  // attach events
  document.querySelectorAll('.pickBtn').forEach(b=>{
    b.onclick = ()=>{ currentPlayerId = b.dataset.id; els.currentPlayerName.textContent = state.players.find(x=>x.id===currentPlayerId)?.name || '—'; setMsg('Player selected. Press Start Turn.'); highlightCurrentPlayer(); };
  });
  document.querySelectorAll('.removeBtn').forEach(b=>{
    b.onclick = ()=>{
      if(currentPlayerId===b.dataset.id) currentPlayerId = null;
      state.players = state.players.filter(x=>x.id!==b.dataset.id);
      saveState(); renderAll();
    };
  });
  highlightCurrentPlayer();
}
function highlightCurrentPlayer(){
  // visual: add glow to the picked player element by matching avatar text
  document.querySelectorAll('.player').forEach(el=>{
    el.classList.remove('glow');
    const nameText = el.querySelector('div > div').textContent || '';
    const firstTwo = (nameText.trim().slice(0,2)).toUpperCase();
    if(currentPlayerId){
      const p = state.players.find(x=>x.id===currentPlayerId);
      if(p && firstTwo === p.name.slice(0,2).toUpperCase()) el.classList.add('glow');
    }
  });
}
function renderLeaderboard(animateChange=true){
  // Sort by score desc then name
  const prev = Array.from(els.leaderboard.children).map(n => n.dataset?.id);
  const sorted = state.players.slice().sort((a,b)=> b.score - a.score || a.name.localeCompare(b.name));
  els.leaderboard.innerHTML = '';
  sorted.forEach((p, idx)=>{
    const item = document.createElement('div');
    item.className = 'leader-item';
    item.dataset.id = p.id;
    item.innerHTML = `<div><strong>${idx+1}. ${escapeHTML(p.name)}</strong><div class="small">played: ${p.played}</div></div><div style="display:flex;gap:10px;align-items:center"><div style="font-weight:800">${p.score}</div>${idx===0?'<div class="badge">1</div>':''}</div>`;
    els.leaderboard.appendChild(item);
    // animate entrance
    requestAnimationFrame(()=> item.classList.add('new'));
    setTimeout(()=> item.classList.remove('new'), 600);
  });
  els.roundsPlayed.textContent = 'Rounds: ' + state.roundsPlayed;
  if(animateChange) animateLeaderboardReorder();
}
function renderRiddleCard(){
  if(!currentRiddle){
    els.rQuestion.textContent = 'Press "Start Turn" or load a random riddle.';
    els.rPoints.textContent = 'Points: —';
    els.hintBox.style.display = 'none'; els.hintBox.textContent = '';
    els.answerInput.value = '';
    return;
  }
  els.rQuestion.textContent = currentRiddle.q;
  els.rPoints.textContent = 'Points: ' + currentRiddle.points;
  els.hintBox.style.display = 'none'; els.hintBox.textContent = '';
  els.answerInput.value = '';
}

/* ======= UI messages ======= */
function setMsg(s){ els.msg.textContent = s; }

/* ======= Actions ======= */
els.addPlayerBtn.onclick = ()=>{
  const name = (els.playerName.value || '').trim();
  if(!name){ setMsg('Enter a valid name'); return; }
  state.players.push({id:uid(), name, score:0, played:0});
  els.playerName.value = '';
  saveState(); renderAll();
  setMsg(`Player "${name}" added.`);
};

els.startTurn.onclick = ()=>{
  if(!currentPlayerId){ setMsg('Pick a player first.'); return; }
  currentRiddle = pickRiddle();
  if(!currentRiddle){ setMsg('No riddles available. Add some.'); return; }
  state.roundsPlayed += 1; saveState();
  renderRiddleCard();
  setMsg('Riddle started — good luck!');
  els.answerInput.focus();
};

els.randomRiddle.onclick = ()=>{
  currentRiddle = pickRiddle(); renderRiddleCard(); setMsg('Random riddle loaded.');
};

els.answerForm.onsubmit = (e)=>{
  e.preventDefault();
  if(!currentRiddle){ setMsg('No active riddle.'); return; }
  if(!currentPlayerId){ setMsg('No player selected.'); return; }
  const answer = (els.answerInput.value || '').trim().toLowerCase();
  if(!answer){ setMsg('Type an answer first.'); return; }
  const correct = (currentRiddle.a||'').toLowerCase();
  if(answer === correct){
    // award points
    let awarded = currentRiddle.points;
    state.players = state.players.map(p=>{
      if(p.id===currentPlayerId){ p.score += awarded; p.played += 1; }
      return p;
    });
    saveState();
    setMsg(`Correct! +${awarded} points.`);
    playSuccessAnimation(currentPlayerId);
    currentRiddle = null;
    renderAll();

  } else {
    setMsg('Incorrect — try again or use hint (costs 3 points).');
    // small shake animation on answer input
    els.answerInput.animate([{transform:'translateX(-6px)'},{transform:'translateX(6px)'},{transform:'translateX(0)'}], {duration:240, iterations:1});
  }
};

els.hintBtn.onclick = ()=>{
  if(!currentRiddle){ setMsg('No active riddle.'); return; }
  if(!currentPlayerId){ setMsg('Pick a player first.'); return; }
  // deduct 3 points
  const cost = 3;
  state.players = state.players.map(p=>{
    if(p.id===currentPlayerId){ p.score = Math.max(0, p.score - cost); }
    return p;
  });
  saveState();
  els.hintBox.style.display = 'block';
  els.hintBox.textContent = currentRiddle.hint || 'No hint available';
  setMsg('Hint shown (3 points deducted).');
  renderLeaderboard();
};

els.skipBtn.onclick = ()=>{
  currentRiddle = null;
  setMsg('Riddle skipped.');
  renderRiddleCard();
};

els.exportCSV.onclick = ()=>{
  const rows = [['Name','Score','Played'], ...state.players.map(p=>[p.name,p.score,p.played])];
  let csv = rows.map(r=>r.map(cell=>`"${String(cell).replace(/"/g,'""')}"`).join(',')).join('\n');
  const blob = new Blob([csv], {type:'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href=url; a.download='riddle_rush_leaderboard.csv'; a.click();
  URL.revokeObjectURL(url);
  setMsg('CSV exported.');
};

els.resetBtn.onclick = ()=>{
  if(confirm('Reset game? Players and riddles will be cleared or reset to defaults.')){
    state = {players:[], riddles: defaultRiddles.slice(), roundsPlayed:0};
    currentPlayerId = null; currentRiddle = null;
    saveState(); renderAll(); setMsg('Game reset.');
    history.replaceState(null,'',location.pathname); // clear share hash if any
  }
};

/* add riddle */
els.addRiddleForm.onsubmit = (e)=>{
  e.preventDefault();
  const q = (els.rQ.value||'').trim();
  const a = (els.rA.value||'').trim().toLowerCase();
  const p = Math.max(1, Number(els.rP.value) || 5);
  const h = (els.rHint.value||'').trim();
  if(!q||!a){ setMsg('Provide riddle and answer.'); return; }
  state.riddles.unshift({id:uid(), q, a, hint:h, points:p});
  saveState();
  els.addRiddleForm.reset();
  els.rP.value = 5;
  setMsg('Riddle added.');
  renderAll();
};
els.clearRiddle.onclick = ()=>{ els.addRiddleForm.reset(); els.rP.value = 5; }

/* copy state to clipboard (JSON) */
els.copyState.onclick = async ()=>{
  try{
    const json = JSON.stringify(state);
    await navigator.clipboard.writeText(json);
    setMsg('Game state copied to clipboard (JSON).');
  }catch(e){ setMsg('Copy failed.'); }
};

/* shareable link (encode state as base64 in hash) */
els.shareLink.onclick = ()=>{
  try{
    const json = JSON.stringify(state);
    const b64 = btoa(json);
    const url = location.origin + location.pathname + '#state:' + encodeURIComponent(b64);
    navigator.clipboard.writeText(url);
    setMsg('Shareable link copied to clipboard.');
  }catch(e){ setMsg('Could not create share link.'); }
};

/* ======= Animations ======= */
function playSuccessAnimation(playerId){
  // briefly highlight the player's leaderboard entry (if exists)
  const el = document.querySelector(`.leader-item[data-id="${playerId}"]`);
  if(el){
    el.classList.add('glow');
    setTimeout(()=> el.classList.remove('glow'), 900);
  }
  // confetti
  fireConfetti();
}

/* FLIP-like simple reorder animation */
function animateLeaderboardReorder(){
  // simple fade/slide already achieved by CSS pop on entry; we also do small transform on reorder
  const nodes = Array.from(els.leaderboard.children);
  nodes.forEach((n,i)=>{
    n.style.transition = 'transform .35s cubic-bezier(.2,.9,.3,1)';
    n.style.transform = 'translateY(6px)';
    requestAnimationFrame(()=> n.style.transform = 'translateY(0)');
  });
}

/* ======= Confetti (simple canvas) ======= */
const confettiCanvas = document.getElementById('confetti');
const ctx = confettiCanvas.getContext('2d');
let confettiPieces = [];
function resizeCanvas(){ confettiCanvas.width = window.innerWidth; confettiCanvas.height = window.innerHeight; confettiCanvas.style.width = '100%'; confettiCanvas.style.height = '100%'; }
window.addEventListener('resize', resizeCanvas);
resizeCanvas();
function fireConfetti(){
  confettiPieces = [];
  const count = 80;
  for(let i=0;i<count;i++){
    confettiPieces.push({
      x: Math.random()*confettiCanvas.width,
      y: -10 - Math.random()*300,
      vx: (Math.random()-0.5)*6,
      vy: 2+Math.random()*5,
      size: 6+Math.random()*10,
      rot: Math.random()*360,
      color: ['#f97316','#f59e0b','#f43f5e','#34d399','#60a5fa','#a78bfa'][Math.floor(Math.random()*6)],
      life: 0
    });
  }
  requestAnimationFrame(confettiLoop);
}
function confettiLoop(){
  ctx.clearRect(0,0,confettiCanvas.width,confettiCanvas.height);
  confettiPieces.forEach(p=>{
    p.x += p.vx; p.y += p.vy; p.vy += 0.06; p.rot += p.vx*3; p.life++;
    ctx.save();
    ctx.translate(p.x,p.y);
    ctx.rotate(p.rot*Math.PI/180);
    ctx.fillStyle = p.color;
    ctx.fillRect(-p.size/2, -p.size/2, p.size, p.size*0.6);
    ctx.restore();
  });
  confettiPieces = confettiPieces.filter(p=>p.y < confettiCanvas.height + 80 && p.life < 260);
  if(confettiPieces.length>0) requestAnimationFrame(confettiLoop);
}

